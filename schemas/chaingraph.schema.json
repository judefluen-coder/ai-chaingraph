{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-chaingraph.local/schemas/chaingraph.schema.json",
  "title": "AI-ChainGraph canonical data model",
  "type": "object",
  "required": ["meta", "chains", "nodes", "companies", "edges", "evidences", "quote_snapshots"],
  "properties": {
    "meta": { "$ref": "#/$defs/meta" },
    "chains": { "type": "array", "items": { "$ref": "#/$defs/chain" } },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/industry_node" } },
    "companies": { "type": "array", "items": { "$ref": "#/$defs/company" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/kg_edge" } },
    "evidences": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "quote_snapshots": { "type": "array", "items": { "$ref": "#/$defs/quote_snapshot" } },
    "market_signals": { "type": "array", "items": { "$ref": "#/$defs/market_signal" } },
    "review_queue": { "type": "array", "items": { "$ref": "#/$defs/review_queue_item" } },
    "import_jobs": { "type": "array", "items": { "$ref": "#/$defs/import_job" } },
    "market_signal_interface": { "$ref": "#/$defs/market_signal_interface" }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "required": ["name", "data_version", "updated_at", "disclaimer"],
      "properties": {
        "name": { "type": "string" },
        "data_version": { "type": "string" },
        "dataset_id": { "type": "string" },
        "dataset_type": { "enum": ["demo", "local_real", "mixed"] },
        "source_policy": { "enum": ["public_demo_only", "local_only", "mixed_review_required"] },
        "latest_import_job_id": { "type": ["string", "null"] },
        "updated_at": { "type": "string", "format": "date-time" },
        "disclaimer": { "type": "string" }
      }
    },
    "chain": {
      "type": "object",
      "required": ["id", "name", "description", "node_count", "company_count", "updated_at"],
      "properties": {
        "id": { "$ref": "#/$defs/chain_id" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "node_count": { "type": "integer", "minimum": 0 },
        "company_count": { "type": "integer", "minimum": 0 },
        "updated_at": { "type": "string" }
      }
    },
    "dataset": {
      "type": "object",
      "required": ["id", "name", "dataset_type", "version", "description", "disclaimer", "source_policy", "created_at", "updated_at"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "dataset_type": { "enum": ["demo", "local_real", "mixed"] },
        "version": { "type": "string" },
        "description": { "type": "string" },
        "disclaimer": { "type": "string" },
        "source_policy": { "enum": ["public_demo_only", "local_only", "mixed_review_required"] },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "import_job": {
      "type": "object",
      "required": ["id", "dataset_id", "adapter_type", "source_name", "status", "total_records", "accepted_records", "review_records", "rejected_records", "created_by", "created_at"],
      "properties": {
        "id": { "type": "string" },
        "dataset_id": { "type": "string" },
        "adapter_type": { "enum": ["demo", "csv", "jsonl", "manual", "snapshot", "quote_mock", "quote_provider"] },
        "source_name": { "type": "string" },
        "source_path": { "type": ["string", "null"] },
        "source_hash": { "type": ["string", "null"] },
        "status": { "enum": ["created", "validated", "partial", "applied", "failed", "reverted"] },
        "total_records": { "type": "integer", "minimum": 0 },
        "accepted_records": { "type": "integer", "minimum": 0 },
        "review_records": { "type": "integer", "minimum": 0 },
        "rejected_records": { "type": "integer", "minimum": 0 },
        "error_json": { "type": "array" },
        "report_json": { "type": "object" },
        "created_by": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "applied_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "industry_node": {
      "type": "object",
      "required": ["id", "name", "node_type", "chain", "parent_id", "level", "aliases", "description", "company_ids", "status", "updated_at"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "node_type": { "enum": ["chain", "segment", "subsegment"] },
        "chain": { "$ref": "#/$defs/chain_id" },
        "parent_id": { "type": ["string", "null"] },
        "level": { "type": "integer", "minimum": 1, "maximum": 3 },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "source_ids": { "type": "array", "items": { "type": "string" } },
        "company_ids": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["active", "draft", "deprecated"] },
        "manual_correction": { "$ref": "#/$defs/manual_correction" },
        "updated_at": { "type": "string" }
      }
    },
    "company": {
      "type": "object",
      "required": ["id", "stock_code", "stock_symbol", "exchange", "name", "industry", "aliases", "source_ids", "updated_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^company:" },
        "stock_code": { "type": "string" },
        "stock_symbol": { "type": "string" },
        "exchange": { "enum": ["SH", "SZ", "BJ"] },
        "name": { "type": "string" },
        "full_name": { "type": ["string", "null"] },
        "industry": { "type": ["string", "null"] },
        "listed_at": { "type": ["string", "null"], "format": "date" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "source_ids": { "type": "array", "items": { "type": "string" } },
        "manual_correction": { "$ref": "#/$defs/manual_correction" },
        "updated_at": { "type": "string" }
      }
    },
    "kg_edge": {
      "type": "object",
      "required": ["id", "from_id", "to_id", "edge_type", "direction", "evidence_level", "relevance_score", "purity_score", "confidence", "source_ids", "review_status", "created_at", "updated_at"],
      "properties": {
        "id": { "type": "string" },
        "from_id": { "type": "string" },
        "to_id": { "type": "string" },
        "edge_type": {
          "enum": [
            "industry_parent",
            "product_upstream_material",
            "product_downstream_application",
            "industry_contains_product",
            "company_belongs_industry",
            "company_main_product",
            "company_maps_to_industry_node",
            "company_supplies_product"
          ]
        },
        "direction": { "enum": ["directed", "undirected"] },
        "weight": { "type": ["number", "null"], "minimum": 0 },
        "evidence_level": { "$ref": "#/$defs/evidence_level" },
        "relevance_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "purity_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source_ids": { "type": "array", "items": { "type": "string" } },
        "review_status": { "enum": ["accepted", "needs_review", "rejected", "stale"] },
        "manual_correction": { "$ref": "#/$defs/manual_correction" },
        "valid_from": { "type": ["string", "null"], "format": "date" },
        "valid_to": { "type": ["string", "null"], "format": "date" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["id", "target_type", "target_id", "level", "source_type", "title", "publish_date", "excerpt", "language", "reliability", "mapped_at", "reviewer", "stale_threshold_days"],
      "properties": {
        "id": { "type": "string" },
        "target_type": { "enum": ["node", "edge", "company", "quote", "signal"] },
        "target_id": { "type": "string" },
        "level": { "$ref": "#/$defs/evidence_level" },
        "source_type": {
          "enum": ["annual_report", "announcement", "research_report", "news", "interview", "patent", "irm_qa", "official_site", "concept_tag", "imported_unverified", "manual", "other"]
        },
        "title": { "type": "string" },
        "url": { "type": ["string", "null"] },
        "local_path": { "type": ["string", "null"] },
        "publish_date": { "type": ["string", "null"], "format": "date" },
        "excerpt": { "type": "string" },
        "language": { "enum": ["zh", "en"] },
        "reliability": { "type": "number", "minimum": 0, "maximum": 1 },
        "mapped_at": { "type": "string", "format": "date-time" },
        "reviewed_at": { "type": ["string", "null"], "format": "date-time" },
        "reviewer": { "type": "string" },
        "stale_threshold_days": { "type": "integer", "minimum": 1 },
        "notes": { "type": ["string", "null"] },
        "manual_correction": { "$ref": "#/$defs/manual_correction" }
      }
    },
    "quote_snapshot": {
      "type": "object",
      "required": ["id", "stock_code", "name", "industry", "market_cap", "latest_price", "change_pct", "turnover_amount", "pe", "pb", "quote_time", "source", "refresh_job_id"],
      "properties": {
        "id": { "type": "string" },
        "stock_code": { "type": "string" },
        "name": { "type": "string" },
        "industry": { "type": ["string", "null"] },
        "market_cap": { "type": ["number", "null"] },
        "latest_price": { "type": ["number", "null"] },
        "change_pct": { "type": ["number", "null"] },
        "turnover_amount": { "type": ["number", "null"] },
        "pe": { "type": ["number", "null"] },
        "pb": { "type": ["number", "null"] },
        "quote_time": { "type": "string", "format": "date-time" },
        "source": { "type": "string" },
        "source_delay_note": { "type": ["string", "null"] },
        "refresh_job_id": { "type": "string" }
      }
    },
    "market_signal": {
      "type": "object",
      "required": ["id", "signal_type", "title", "summary", "target_ids", "severity", "source_system", "received_at", "payload", "evidence_ids", "status"],
      "properties": {
        "id": { "type": "string" },
        "signal_type": { "enum": ["event", "alert", "sentiment", "policy", "earnings", "supply_chain", "custom"] },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "target_ids": { "type": "array", "items": { "type": "string" } },
        "severity": { "enum": ["info", "watch", "important", "critical"] },
        "source_system": { "type": "string" },
        "occurred_at": { "type": ["string", "null"], "format": "date-time" },
        "received_at": { "type": "string", "format": "date-time" },
        "payload": { "type": "object" },
        "evidence_ids": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["new", "linked", "ignored", "archived"] }
      }
    },
    "review_queue_item": {
      "type": "object",
      "required": ["id", "target_type", "target_id", "issue_type", "payload", "status", "created_by", "created_at"],
      "properties": {
        "id": { "type": "string" },
        "target_type": { "enum": ["node", "edge", "evidence", "quote", "company"] },
        "target_id": { "type": "string" },
        "issue_type": { "enum": ["stale", "incorrect", "wrong_mapping", "wrong_category", "concept_pollution", "add_evidence"] },
        "payload": { "type": "object" },
        "status": { "enum": ["pending", "accepted", "rejected", "needs_more_source"] },
        "created_by": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "resolved_at": { "type": ["string", "null"], "format": "date-time" },
        "resolution_note": { "type": ["string", "null"] }
      }
    },
    "market_signal_interface": {
      "type": "object",
      "required": ["status", "endpoint_contract", "accepted_payload", "note"],
      "properties": {
        "status": { "enum": ["reserved", "enabled", "disabled"] },
        "endpoint_contract": { "type": "string" },
        "accepted_payload": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "manual_correction": {
      "type": "object",
      "properties": {
        "review_status": { "enum": ["accepted", "needs_review", "rejected", "stale"] },
        "reviewer": { "type": "string" },
        "reviewed_at": { "type": ["string", "null"], "format": "date-time" },
        "correction_note": { "type": ["string", "null"] },
        "source_review_queue_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "chain_id": {
      "enum": ["compute_hardware", "optical_communication", "pcb_materials", "power_liquid_cooling"]
    },
    "evidence_level": {
      "enum": ["L1", "L2", "L3"]
    }
  }
}
