{
  "name": "ai-chaingraph",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/build-release-history.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build-release-history.mjs && vite build && node scripts/write-release-revision.mjs",
    "prebuild:sites": "node scripts/clear-sites-artifact.mjs && npm audit --audit-level=high && npm test && npm run validate:snapshot && npm run audit:relationships -- --min-specific-issuer-rate=0.9 --max-check-age-days=8 --max-a-share-listing-reconciliation-age-days=8 && npm run audit:semantic-precision && npm run check:performance && npm run test:e2e",
    "build:sites": "npm run build && node scripts/build-sites.mjs",
    "check:sites-release-ready": "node scripts/verify-release-parity.mjs --preflight",
    "verify:sites-deployed": "node scripts/verify-release-parity.mjs --deployed",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test",
    "test:e2e": "playwright test",
    "benchmark:graph": "node scripts/benchmark-graph.mjs",
    "check:performance": "node scripts/benchmark-graph.mjs --check",
    "validate:snapshot": "node scripts/validate-public-snapshot.mjs",
    "audit:relationships": "node scripts/audit-relationship-depth.mjs",
    "audit:semantic-precision": "node scripts/audit-semantic-precision.mjs",
    "update:weekly": "node scripts/update-weekly-snapshot.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  }
}
