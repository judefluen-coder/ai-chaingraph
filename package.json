{
  "name": "ai-chaingraph",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:sites": "npm run build && node scripts/build-sites.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "api": "node scripts/serve-api.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "validate:example": "node scripts/import-snapshot.mjs examples/fictional-ai-chain.snapshot.json",
    "validate:tabular": "node scripts/import-tabular.mjs examples/fictional-ai-mappings.csv && node scripts/import-tabular.mjs examples/fictional-ai-mappings.jsonl && node scripts/import-tabular.mjs examples/fictional-ai-mappings-duplicates.csv",
    "validate:data:v1": "node scripts/import-tabular.mjs datasets/v1/verified-mappings.csv --ontology --manifest datasets/v1/manifest.json",
    "validate:ontology": "node scripts/validate-ontology.mjs",
    "validate:graph-contract:v1.1": "node scripts/validate-transmission-graph.mjs --check",
    "validate:migration:v1.1": "node scripts/migrate-v1-to-v1.1.mjs --check",
    "migrate:graph:v1.1": "node scripts/migrate-v1-to-v1.1.mjs --check --write",
    "validate:backbone:v1.1": "node scripts/apply-transmission-backbone-v1.1.mjs --check",
    "apply:backbone:v1.1": "node scripts/apply-transmission-backbone-v1.1.mjs --check --write",
    "validate:issuer-elements:v1.1": "node scripts/resolve-issuer-element-mappings-v1.1.mjs --check",
    "apply:issuer-elements:v1.1": "node scripts/resolve-issuer-element-mappings-v1.1.mjs --check --write",
    "validate:public:v1.1": "node scripts/build-public-transmission-view-v1.1.mjs --check",
    "build:public:v1.1": "node scripts/build-public-transmission-view-v1.1.mjs --write",
    "validate:ui:v1.1": "node scripts/validate-transmission-ui-v1.1.mjs --check",
    "validate:release:v1.1": "node scripts/audit-v1.1-release.mjs --data-strict --check",
    "audit:release:v1.1": "node scripts/audit-v1.1-release.mjs",
    "release:check:v1.1": "node scripts/audit-v1.1-release.mjs --strict --check",
    "promote:release:v1.1": "node scripts/promote-v1.1-release.mjs --write",
    "validate:queries:v1.1": "node scripts/validate-transmission-queries-v1.1.mjs --check",
    "validate:sqlite:v1.1": "node scripts/import-transmission-snapshot-sqlite.mjs --check",
    "import:sqlite:v1.1": "node scripts/import-transmission-snapshot-sqlite.mjs --input data/snapshots/v1.1-building.json --write",
    "validate:securities:us": "node scripts/sync-securities-us.mjs --input examples/sec-company-tickers-exchange.sample.json --check",
    "validate:securities:cn": "node scripts/sync-securities-cn.mjs --input examples/cn-exchange-securities.sample.json --fallback-fixture examples/cninfo-szse-census.sample.json --check",
    "sync:securities:us": "node scripts/sync-securities-us.mjs",
    "validate:securities:us-classification": "node scripts/classify-securities-us.mjs --securities examples/us-sec-securities.sample.json --nasdaq examples/nasdaqlisted.sample.txt --other examples/otherlisted.sample.txt --expect-unmatched 1 --check",
    "classify:securities:us": "node scripts/classify-securities-us.mjs",
    "sync:securities:cn": "node scripts/sync-securities-cn.mjs",
    "validate:screening": "node scripts/generate-screening-ledger.mjs --input examples/security-universe.sample.json --check",
    "generate:screening": "node scripts/generate-screening-ledger.mjs --input data/securities/cn-exchanges.json --input data/securities/us-classified.json --output data/screening/current.json",
    "validate:coverage": "node scripts/generate-coverage-report.mjs --ledger examples/screening-ledger.sample.json --graph examples/coverage-graph.sample.json --manifest examples/coverage-manifest.sample.json --check",
    "generate:coverage": "node scripts/generate-coverage-report.mjs --ledger data/screening/current.json --graph data/snapshots/current.json --manifest datasets/v1/manifest.json --output data/reports/global-coverage.md",
    "audit:coverage:a-share": "node scripts/audit-a-share-coverage.mjs",
    "sync:a-share-bom-decisions": "node scripts/sync-a-share-bom-decisions.mjs",
    "validate:sources:sec": "node scripts/collect-sec-filings.mjs --securities examples/us-classified-securities-with-cik.sample.json --fixture examples/sec-submissions.sample.json --check",
    "collect:sources:sec": "node scripts/collect-sec-filings.mjs",
    "validate:sources:sec-search": "node scripts/collect-sec-full-text-candidates.mjs --securities examples/us-classified-securities-with-cik.sample.json --fixture examples/sec-full-text-search.sample.json --check",
    "collect:sources:sec-search": "node scripts/collect-sec-full-text-candidates.mjs",
    "validate:sources:cn": "node scripts/collect-cninfo-announcements.mjs --securities examples/cn-securities-normalized.sample.json --fixture examples/cninfo-announcements.sample.json --check",
    "collect:sources:cn": "node scripts/collect-cninfo-announcements.mjs",
    "collect:sources:cn-bom": "node scripts/collect-cninfo-announcements.mjs --terms ontology/ai-bom-terms-zh-v1.json --output data/sources/cninfo-bom-announcements.json",
    "validate:sources:cn-annual-reports": "node scripts/collect-cninfo-annual-reports.mjs --securities examples/cn-securities-annual-report.sample.json --fixture examples/cninfo-annual-report-census.sample.json --report-year 2025 --from 2026-01-01 --to 2026-07-12 --check",
    "collect:sources:cn-annual-reports": "node scripts/collect-cninfo-annual-reports.mjs",
    "validate:a-share-annual-report-scan": "node scripts/scan-a-share-annual-reports.mjs --fixture examples/a-share-annual-report-bom-scan.sample.json --limit 10 --check",
    "scan:a-share-annual-reports": "node scripts/scan-a-share-annual-reports.mjs",
    "validate:a-share-annual-report-review-queue": "node scripts/generate-a-share-annual-report-review-queue.mjs --fixture examples/a-share-annual-report-review-queue.sample.json --check",
    "generate:a-share-annual-report-review-queue": "node scripts/generate-a-share-annual-report-review-queue.mjs",
    "generate:a-share-source-fallback-queue": "node scripts/generate-a-share-source-fallback-queue.mjs",
    "validate:a-share-business-exclusions": "node scripts/resolve-a-share-business-exclusions.mjs --fixture examples/a-share-business-exclusions.sample.json --check",
    "resolve:a-share-business-exclusions": "node scripts/resolve-a-share-business-exclusions.mjs",
    "apply:a-share-review-batch": "node scripts/apply-a-share-review-batch.mjs",
    "backfill:a-share-passive-components": "node scripts/apply-node-backfill-passive-components.mjs",
    "validate:a-share-bom-candidates": "node scripts/generate-a-share-bom-candidates.mjs --fixture examples/a-share-bom-candidates.sample.json --check",
    "generate:a-share-bom-candidates": "node scripts/generate-a-share-bom-candidates.mjs",
    "validate:a-share-node-backfill-audit": "node scripts/generate-a-share-node-backfill-audit.mjs --fixture examples/a-share-node-backfill-audit.sample.json --check",
    "generate:a-share-node-backfill-audit": "node scripts/generate-a-share-node-backfill-audit.mjs",
    "validate:discovery": "node scripts/generate-discovery-matrix.mjs --input examples/discovery-candidate-index.sample.json --input examples/discovery-candidate-index-en.sample.json --require-complete --check",
    "generate:discovery": "node scripts/generate-discovery-matrix.mjs",
    "validate:screening-apply": "node scripts/apply-screening-results.mjs --fixture examples/screening-application.sample.json --check",
    "apply:screening": "node scripts/apply-screening-results.mjs --ledger data/screening/current.json --graph data/snapshots/current.json --discovery data/screening/discovery-matrix.json --output data/screening/current.json",
    "validate:verification-queue": "node scripts/generate-verification-queue.mjs --fixture examples/verification-queue.sample.json --check",
    "generate:verification-queue": "node scripts/generate-verification-queue.mjs",
    "validate:sec-contexts": "node scripts/extract-sec-document-contexts.mjs --fixture examples/sec-document-contexts.sample.json --check && node scripts/extract-sec-document-contexts.mjs --fixture examples/sec-document-contexts.sample.json --retry-failures-from examples/sec-document-contexts.retry.sample.json --check",
    "extract:sec-contexts": "node scripts/extract-sec-document-contexts.mjs",
    "reclassify:sec-contexts": "node scripts/extract-sec-document-contexts.mjs --reclassify-existing data/screening/sec-document-contexts.json",
    "validate:sec-resolutions": "node scripts/apply-sec-context-resolutions.mjs --fixture examples/sec-context-resolution.sample.json --check && node scripts/apply-sec-context-resolutions.mjs --fixture examples/sec-term-not-found-resolution.sample.json --check",
    "apply:sec-resolutions": "node scripts/apply-sec-context-resolutions.mjs",
    "validate:cninfo-contexts": "node scripts/extract-cninfo-document-contexts.mjs --fixture examples/cninfo-document-contexts.sample.json --check",
    "extract:cninfo-contexts": "node scripts/extract-cninfo-document-contexts.mjs",
    "validate:cninfo-resolutions": "node scripts/apply-cninfo-context-resolutions.mjs --fixture examples/cninfo-context-resolution.sample.json --check",
    "apply:cninfo-resolutions": "node scripts/apply-cninfo-context-resolutions.mjs",
    "validate:release:v1": "node scripts/audit-v1-release.mjs --fixture examples/v1-release-ready.sample.json --check",
    "audit:release:v1": "node scripts/audit-v1-release.mjs",
    "release:check:v1": "node scripts/audit-v1-release.mjs --strict --check",
    "publish:snapshot:v1": "node scripts/publish-v1-snapshot.mjs",
    "publish:snapshot:building": "node scripts/publish-v1-snapshot.mjs --building",
    "import:snapshot": "node scripts/import-snapshot.mjs",
    "import:tabular": "node scripts/import-tabular.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "html-to-text": "^10.0.0",
    "htmlparser2": "^10.1.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4",
    "vite": "^7.2.7"
  }
}
